* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Unity text assets should keep stable line endings.
*.cs text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.inputactions text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.anim text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
